    "@types/node": "^20.11.5",
    "@types/uuid": "^9.0.7",
    "esbuild": "^0.19.11",
    "esbuild-plugin-clean": "^1.0.1",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "ts-jest": "^29.1.2",
